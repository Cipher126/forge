FORGE_ENVIRONMENT=development
FORGE_LOG_LEVEL=INFO
FORGE_OTLP_TRACING_ENABLED=false
FORGE_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
FORGE_TRACE_SAMPLE_RATIO=1.0
FORGE_API_HOST=127.0.0.1
FORGE_API_PORT=8000
FORGE_API_WORKERS=1
FORGE_MAX_REQUEST_BODY_BYTES=10485760
FORGE_MAX_INLINE_PAYLOAD_BYTES=262144

FORGE_POSTGRES_URL=postgresql+asyncpg://forge:forge@127.0.0.1:54321/forge
FORGE_POSTGRES_CONNECT_TIMEOUT_SECONDS=0.5
FORGE_POSTGRES_POOL_TIMEOUT_SECONDS=1.0
FORGE_POSTGRES_RETRY_BASE_MS=250
FORGE_POSTGRES_RETRY_CAP_MS=5000
FORGE_POSTGRES_POOL_SIZE=5
FORGE_POSTGRES_MAX_OVERFLOW=5
FORGE_POSTGRES_POOL_TIMEOUT_SECONDS=30
FORGE_POSTGRES_POOL_RECYCLE_SECONDS=1800
FORGE_REDIS_URL=redis://127.0.0.1:56379/0

FORGE_REDIS_OPERATION_TIMEOUT_SECONDS=1.0
FORGE_REDIS_RETRY_BASE_MS=250
FORGE_REDIS_RETRY_CAP_MS=5000
FORGE_OBJECT_STORE_ENDPOINT_URL=http://127.0.0.1:59000
FORGE_OBJECT_STORE_ACCESS_KEY=forge
FORGE_OBJECT_STORE_SECRET_KEY=development-only-change-me
FORGE_OBJECT_STORE_BUCKET=forge-jobs
FORGE_OBJECT_STORE_CONNECT_TIMEOUT_SECONDS=0.5
FORGE_OBJECT_STORE_READ_TIMEOUT_SECONDS=1.0
FORGE_OBJECT_STORE_MAX_ATTEMPTS=2
FORGE_OBJECT_STORE_OPERATION_TIMEOUT_SECONDS=3.0
FORGE_API_KEY_PEPPER=development-only-change-me
FORGE_DISPATCHER_BATCH_SIZE=100
FORGE_DISPATCHER_LEASE_SECONDS=30
FORGE_DISPATCHER_POLL_INTERVAL_MS=500
FORGE_DISPATCHER_RETRY_BASE_MS=500
FORGE_DISPATCHER_RETRY_CAP_MS=30000
FORGE_WORKER_ATTEMPT_LEASE_SECONDS=30
FORGE_WORKER_LEASE_RENEW_INTERVAL_SECONDS=10
FORGE_WORKER_RETRY_BASE_MS=1000
FORGE_WORKER_RETRY_CAP_MS=60000
FORGE_WORKER_CONCURRENCY=4
FORGE_WORKER_POLL_INTERVAL_MS=100
FORGE_JOB_TYPE_CONCURRENCY_LIMITS={"demo.generate_report":2}
FORGE_JOB_TYPE_PERMIT_LEASE_SECONDS=30
FORGE_JOB_TYPE_PERMIT_RENEW_INTERVAL_SECONDS=10
FORGE_ADMISSION_BACKLOG_LIMIT=50000
FORGE_ADMISSION_RETRY_AFTER_SECONDS=1
FORGE_SCHEDULER_BATCH_SIZE=100
FORGE_SCHEDULER_POLL_INTERVAL_MS=500
FORGE_RECOVERY_BATCH_SIZE=100
FORGE_RECOVERY_POLL_INTERVAL_MS=1000
FORGE_DELIVERY_RECONCILIATION_INTERVAL_SECONDS=30
FORGE_MAINTENANCE_INTERVAL_SECONDS=3600
FORGE_MAINTENANCE_BATCH_SIZE=100
FORGE_JOB_RETENTION_DAYS=30
FORGE_ORPHAN_OBJECT_GRACE_HOURS=24
FORGE_OPERATIONAL_STREAM_POLL_MS=1000
FORGE_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
FORGE_WORKER_HEARTBEAT_TTL_SECONDS=15

FORGE_DEV_POSTGRES_DB=forge
FORGE_DEV_POSTGRES_USER=forge
FORGE_DEV_POSTGRES_PASSWORD=forge
FORGE_DEV_OBJECT_STORE_ACCESS_KEY=forge

FORGE_ENVIRONMENT=production
FORGE_LOG_LEVEL=INFO
FORGE_OTLP_TRACING_ENABLED=false
FORGE_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
FORGE_TRACE_SAMPLE_RATIO=0.1
FORGE_API_HOST=0.0.0.0
FORGE_API_PORT=8000

FORGE_POSTGRES_URL=postgresql+asyncpg://forge:CHANGE_ME@postgres.example:5432/forge
FORGE_POSTGRES_POOL_SIZE=5
FORGE_POSTGRES_MAX_OVERFLOW=5
FORGE_POSTGRES_POOL_TIMEOUT_SECONDS=30
FORGE_POSTGRES_POOL_RECYCLE_SECONDS=1800
FORGE_REDIS_URL=rediss://:CHANGE_ME@redis.example:6379/0

FORGE_OBJECT_STORE_ENDPOINT_URL=https://objects.example
FORGE_OBJECT_STORE_ACCESS_KEY=CHANGE_ME
FORGE_OBJECT_STORE_SECRET_KEY=CHANGE_ME
FORGE_OBJECT_STORE_BUCKET=forge-jobs
FORGE_API_KEY_PEPPER=CHANGE_ME

FORGE_WORKER_CONCURRENCY=4
FORGE_ADMISSION_BACKLOG_LIMIT=50000
FORGE_JOB_TYPE_CONCURRENCY_LIMITS={"demo.generate_report":2}
